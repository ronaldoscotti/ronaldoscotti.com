# Netlify / Cloudflare Pages. Real 301s instead of the meta refresh where the
# platform supports it. The ?lang=en carries the explicit English choice, which
# the head script reads, persists, and strips from the URL.
/en      /?lang=en    301
/en/*    /?lang=en    301
/es      /?lang=en    301
/es/*    /?lang=en    301
