---
import "../styles/global.css";
import type { Language } from "../i18n/types";
import { getTranslations, getAlternateLanguage, getLanguagePath } from "../i18n/utils";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const siteUrl = "https://ronaldoscotti.com";
const ogImage = `${siteUrl}/og-image.png`;

// Language-specific URLs
const currentPath = getLanguagePath(lang);
const currentUrl = `${siteUrl}${currentPath === '/' ? '' : currentPath}`;
const alternateLang = getAlternateLanguage(lang);
const alternatePath = getLanguagePath(alternateLang);
const alternateUrl = `${siteUrl}${alternatePath === '/' ? '' : alternatePath}`;

// Language codes for meta tags
const htmlLang = lang === 'pt-BR' ? 'pt-BR' : lang === 'en' ? 'en' : 'es';
const ogLocale = lang === 'pt-BR' ? 'pt_BR' : lang === 'en' ? 'en_US' : 'es_ES';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- SEO Meta Tags -->
    <title>{t.seo.title}</title>
    <meta
      name="description"
      content={t.seo.description}
    />
    <meta
      name="keywords"
      content={t.seo.keywords}
    />
    <meta
      name="author"
      content="Ronaldo Scotti"
    />

    <!-- Open Graph / Facebook -->
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:url"
      content={currentUrl}
    />
    <meta
      property="og:title"
      content={t.seo.ogTitle}
    />
    <meta
      property="og:description"
      content={t.seo.ogDescription}
    />
    <meta
      property="og:image"
      content={ogImage}
    />
    <meta
      property="og:locale"
      content={ogLocale}
    />

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={t.seo.twitterTitle}
    />
    <meta
      name="twitter:description"
      content={t.seo.twitterDescription}
    />
    <meta
      name="twitter:image"
      content={ogImage}
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9L0PMZX1P3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9L0PMZX1P3');
    </script>

    <!-- hreflang tags for multilingual SEO -->
    <link rel="alternate" hreflang="pt-BR" href={siteUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/es`} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <!-- Canonical -->
    <link
      rel="canonical"
      href={currentUrl}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/ronaldo-scotti.jpeg" />
    <link rel="apple-touch-icon" href="/ronaldo-scotti.jpeg" />

    <!-- Preload Critical Resources -->
    <link
      rel="preload"
      as="image"
      href="/ronaldo-scotti.jpeg"
      fetchpriority="high"
    />

    <!-- Fonts -->
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />

    <!-- Schema Markup - Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ronaldo Scotti",
      "alternateName": "Ronaldo Scottis",
      "url": "https://ronaldoscotti.com",
      "image": "https://ronaldoscotti.com/ronaldo-scotti.jpeg",
      "sameAs": [
        "https://www.linkedin.com/in/ronaldoscottis/",
        "https://github.com/ronaldoscotti",
        "https://jornadasaas.com"
      ],
      "jobTitle": t.schema.person.jobTitle,
      "worksFor": {
        "@type": "Organization",
        "name": "Eduzz"
      },
      "knowsAbout": [
        "SaaS Development",
        "Automations",
        "AI Agents",
        "JavaScript",
        "React",
        "Node.js",
        "PHP",
        "Laravel",
        "MVP Validation"
      ],
      "hasOccupation": {
        "@type": "Occupation",
        "name": "Software Developer and Consultant",
        "occupationLocation": {
          "@type": "City",
          "name": "Santa Catarina, Brazil"
        }
      },
      "description": t.schema.person.description,
      "inLanguage": htmlLang
    })} />

    <!-- Schema Markup - WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": t.schema.website.name,
      "url": "https://ronaldoscotti.com",
      "description": t.schema.website.description,
      "author": {
        "@type": "Person",
        "name": "Ronaldo Scotti"
      },
      "inLanguage": htmlLang
    })} />

    <!-- Schema Markup - ProfessionalService -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": t.schema.professionalService.name,
      "description": t.schema.professionalService.description,
      "provider": {
        "@type": "Person",
        "name": "Ronaldo Scotti"
      },
      "areaServed": "BR",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": t.schema.professionalService.catalogName,
        "itemListElement": t.schema.professionalService.offers.map((offer) => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": offer.name,
            "description": offer.description
          }
        }))
      },
      "inLanguage": htmlLang
    })} />
  </head>
  <body class="bg-white text-zinc-900 antialiased">
    <slot />

    <!-- Language Switcher Script -->
    <script>
      import '../scripts/languageSwitcher';
    </script>

    <!-- Scroll Animation Script -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Intersection Observer for scroll animations
        const observerOptions = {
          threshold: 0.1,
          rootMargin: "0px 0px -50px 0px",
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
            }
          });
        }, observerOptions);

        // Observe all elements with animate-on-scroll class
        document.querySelectorAll(".animate-on-scroll").forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>
