---
import "../styles/global.css";
import type { Language } from "../i18n/types";
import {
  getTranslations,
  getAlternateLanguage,
  getLanguagePath,
  getHtmlLang,
  getOgLocale,
} from "../i18n/utils";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const siteUrl = "https://ronaldoscotti.com";
const path = getLanguagePath(lang);
const currentUrl = path === "/" ? siteUrl : `${siteUrl}${path}`;
const ogImage = `${siteUrl}/og-image.png`;

/** No worksFor: it goes stale on a job change. */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ronaldo Scotti",
  url: siteUrl,
  image: `${siteUrl}/ronaldo-scotti.webp`,
  jobTitle: t.schema.jobTitle,
  description: t.schema.description,
  email: "mailto:ronaldoscottis@gmail.com",
  knowsAbout: t.schema.knowsAbout,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Florianópolis",
    addressRegion: "SC",
    addressCountry: "BR",
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "PUCRS" },
    { "@type": "CollegeOrUniversity", name: "Centro Universitário Unifacvest" },
  ],
  sameAs: ["https://linkedin.com/in/ronaldoscottis", "https://github.com/ronaldoscotti"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Ronaldo Scotti",
  url: siteUrl,
  inLanguage: getHtmlLang(lang),
  description: t.seo.description,
};
---

<!doctype html>
<html lang={getHtmlLang(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{t.seo.title}</title>
    <meta name="description" content={t.seo.description} />
    <meta name="author" content="Ronaldo Scotti" />
    <link rel="canonical" href={currentUrl} />

    <link rel="alternate" hreflang="en" href={siteUrl} />
    <link rel="alternate" hreflang="pt-BR" href={`${siteUrl}/pt`} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={t.seo.ogTitle} />
    <meta property="og:description" content={t.seo.ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={getOgLocale(lang)} />
    <meta property="og:site_name" content="Ronaldo Scotti" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.seo.ogTitle} />
    <meta name="twitter:description" content={t.seo.ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/ronaldo-scotti-sm.webp" />
    <meta name="theme-color" content="#efe6d6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0c0b" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/ronaldo-scotti.webp" as="image" fetchpriority="high" />

    <script is:inline>
      // Runs before first paint so a stored choice never flashes the wrong theme.
      // Always resolves to a concrete value, including on a first visit: leaving
      // the attribute unset makes the first toggle click a no-op, because it
      // would write the theme the system was already showing.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = stored === "dark" || stored === "light" ? stored : system;
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>

  <body>
    <a href="#main" class="skip">{t.nav.skipToContent}</a>
    <slot />

    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduce || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-ink);
        color: var(--color-paper);
        padding: 0.75rem 1.25rem;
        text-decoration: none;
        font-size: 0.875rem;
      }

      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }
    </style>
  </body>
</html>
