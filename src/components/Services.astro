---
import type { Language } from '../i18n/types';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section
  id="ajuda"
  class="py-10 sm:py-16 px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40"
>
  <div class="max-w-[960px] mx-auto">
    <div class="flex flex-col gap-4 text-center mb-10">
      <h2
        class="text-zinc-900 text-[32px] md:text-4xl font-bold leading-tight tracking-[-0.033em] max-w-[720px] mx-auto"
      >
        {t.services.heading}
      </h2>
      <p
        class="text-zinc-600 text-lg font-normal leading-normal max-w-[720px] mx-auto"
      >
        {t.services.intro}
      </p>
    </div>

    <div class="flex flex-col gap-8">
      {
        t.services.items.map((service) => (
          <div class="flex items-start gap-4">
            <div class="text-2xl font-bold text-zinc-400">
              {service.number}.
            </div>
            <div>
              <h3 class="text-zinc-900 text-lg font-bold">{service.title}</h3>
              <p class="text-zinc-700 mt-1">{service.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
