---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);
---

<Section id={id} index={index} heading={t.contact.heading}>
  <div class="reveal">
    <div class="head">
      <img
        class="avatar"
        src="/ronaldo-scotti-avatar.webp"
        alt={t.hero.photoAlt}
        width="400"
        height="399"
        loading="lazy"
        decoding="async"
      />
      <a class="email" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>
    </div>

    <p class="links">
      {
        t.contact.links.map((link) => (
          <a href={link.url} rel="noopener">
            {link.label}
          </a>
        ))
      }
      <a href="/cv.pdf" download>{t.nav.resume}</a>
    </p>

    <p class="mono location">{t.contact.location}</p>
  </div>
</Section>

<style>
  /* The hero portrait is an illustration, so this is the one place on the page
     that shows an actual photograph of him. */
  .head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .avatar {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-accent) 34%, transparent);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.6);
  }

  .email {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    /* Trim the line box to the glyphs so aligning centres in .head lands the
       text optically level with the avatar, not sitting low in its own leading. */
    line-height: 1;
    letter-spacing: -0.015em;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    text-underline-offset: 0.14em;
    word-break: break-word;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .links a {
    color: var(--color-ink-mute);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-accent-deep);
  }

  .location {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    line-height: 1.7;
  }
</style>
