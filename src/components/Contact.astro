---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);
---

<Section id={id} index={index} heading={t.contact.heading}>
  <div class="reveal">
    <a class="email" href={`mailto:${t.contact.email}`}>{t.contact.email}</a>

    <p class="links">
      {t.contact.links.map((link) => <a href={link.url} rel="noopener">{link.label}</a>)}
      <a href="/cv.pdf" download>{t.nav.resume}</a>
    </p>

    <p class="mono location">{t.contact.location}</p>
  </div>
</Section>

<style>
  .email {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    text-underline-offset: 0.14em;
    word-break: break-word;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }

  .location {
    margin-top: 1.75rem;
    line-height: 1.7;
  }
</style>
