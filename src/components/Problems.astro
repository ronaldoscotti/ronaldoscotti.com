---
import type { Language } from '../i18n/types';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="py-10 sm:py-16 px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40">
  <div class="max-w-[960px] mx-auto">
    <div class="bg-zinc-900 text-white rounded-xl p-8 sm:p-10 text-center">
      <h2 class="text-white text-[32px] md:text-4xl font-bold leading-tight tracking-[-0.033em] max-w-[720px] mx-auto">
        {t.problems.heading}
      </h2>
      <p class="text-zinc-300 text-lg font-normal leading-normal max-w-[720px] mx-auto mt-6">
        {t.problems.scenarios.map((scenario, index) => (
          <>
            {scenario}
            {index < t.problems.scenarios.length - 1 && <><br/><br/></>}
          </>
        ))}
      </p>
      <p class="text-white text-lg font-bold leading-normal max-w-[720px] mx-auto mt-6">
        {t.problems.closingStatement}
      </p>
    </div>
  </div>
</section>
