---
import type { Language } from '../i18n/types';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="py-10 sm:py-16 px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40">
  <div class="max-w-[960px] mx-auto">
    <h3
      class="text-zinc-900 text-2xl font-bold leading-tight tracking-[-0.015em] text-center mb-8"
    >
      {t.clients.heading}
    </h3>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 items-center">
      <img
        class="grayscale opacity-60 hover:opacity-100 transition-opacity mx-auto"
        alt="Eduzz logo"
        src="/clients/eduzz.webp"
      />
      <img
        class="grayscale opacity-60 hover:opacity-100 transition-opacity mx-auto"
        alt="Natura logo"
        src="/clients/natura.webp"
        style="margin-top: -5px"
      />
      <img
        class="grayscale opacity-60 hover:opacity-100 transition-opacity mx-auto"
        alt="Algar logo"
        src="/clients/algar.webp"
        style="margin-bottom: -15px"
      />
      <img
        class="grayscale opacity-60 hover:opacity-100 transition-opacity mx-auto"
        alt="BMG logo"
        src="/clients/bmg.webp"
        style="margin-bottom: -20px"
      />
    </div>
  </div>
</section>
