---
import type { Language } from "../i18n/types";
import { getTranslations, getAlternateLanguage, getLanguagePath } from "../i18n/utils";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const alternate = getAlternateLanguage(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <p class="line">
      <span>Ronaldo Scotti</span>
      <span class="dot">·</span>
      <span>Florianópolis, {lang === "en" ? "Brazil" : "Brasil"}</span>
      <span class="dot">·</span>
      <span>{year}</span>
    </p>

    <p class="line no-print">
      <a href={`mailto:${t.contact.email}`}>{lang === "en" ? "Email" : "E-mail"}</a>
      <a href="https://linkedin.com/in/ronaldoscottis" rel="noopener">LinkedIn</a>
      <a href="https://github.com/ronaldoscotti" rel="noopener">GitHub</a>
      <a href={getLanguagePath(alternate)}>{alternate === "en" ? "English" : "Português"}</a>
    </p>

    <p class="motto">{t.footer.motto}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    padding-block: 2.5rem 3.5rem;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.8125rem;
    color: var(--color-ink-mute);
  }

  .line a {
    color: var(--color-ink-mute);
    text-decoration: none;
  }

  .line a:hover {
    color: var(--color-accent-deep);
    text-decoration: underline;
  }

  .dot {
    opacity: 0.5;
  }

  .motto {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-mute);
  }
</style>
