---
import type { Language } from '../i18n/types';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="trajetoria" class="py-10 sm:py-16 px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40">
  <div class="max-w-[960px] mx-auto">
    <h2 class="text-zinc-900 text-2xl sm:text-3xl font-bold leading-tight tracking-[-0.015em] pb-8">
      {t.journey.heading}
    </h2>

    <div class="grid grid-cols-[40px_1fr] gap-x-2">
      {t.journey.timeline.map((item, index) => (
        <>
          {/* Icon column */}
          <div class="flex flex-col items-center gap-2 pt-3">
            <span class="material-symbols-outlined text-zinc-500">{item.icon}</span>
            {index < t.journey.timeline.length - 1 && (
              <div class="w-[1.5px] bg-zinc-200 h-full grow"></div>
            )}
          </div>

          {/* Content column */}
          <div class={`flex flex-1 flex-col ${index < t.journey.timeline.length - 1 ? 'pb-8' : ''}`}>
            <p class="text-zinc-500 text-sm font-medium leading-normal">{item.period}</p>
            <p class="text-zinc-900 text-lg font-bold leading-normal">{item.title}</p>
            <p class="text-zinc-700 text-base font-normal leading-normal mt-1">{item.description}</p>
          </div>

          {/* Spacing between items (except last) */}
          {index < t.journey.timeline.length - 1 && (
            <>
              <div class="flex flex-col items-center gap-2">
                <div class="w-[1.5px] bg-zinc-200 h-2 grow"></div>
              </div>
              <div></div>
            </>
          )}
        </>
      ))}
    </div>
  </div>
</section>
