---
import type { Language } from '../i18n/types';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<header
  id="navbar"
  class="sticky top-0 z-50 bg-white/80 backdrop-blur-md transition-all duration-300"
>
  <nav
    class="flex h-16 items-center justify-center px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40"
  >
    <div
      class="relative flex w-full max-w-[960px] items-center justify-between"
    >
      <!-- Logo -->
      <a
        href="#"
        class="flex items-center"
      >
        <img
          src="/logo-ronaldo-scotti.png"
          alt="Ronaldo Scotti"
          class="h-5 md:h-6"
        />
      </a>

      <!-- Navigation Links - Centralized -->
      <div
        class="absolute left-1/2 -translate-x-1/2 hidden items-center gap-6 md:flex"
      >
        {
          t.nav.links.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-zinc-600 hover:text-zinc-900 transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Right side: CTA + Language Selector -->
      <div class="flex items-center gap-3">
        <!-- CTA Button -->
        <a
          href={t.nav.contactHref}
          class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-9 px-4 bg-zinc-900 text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-zinc-800 transition-colors"
        >
          <span class="truncate">{t.nav.contactButton}</span>
        </a>

        <!-- Language Selector -->
        <div class="relative">
          <button
            id="lang-selector"
            class="flex items-center gap-1 text-sm font-medium text-zinc-600 hover:text-zinc-900 transition-colors cursor-pointer"
            aria-label="Select language"
            aria-expanded="false"
          >
            <span>{lang === 'en' ? 'EN' : lang === 'es' ? 'ES' : 'PT'}</span>
            <span class="material-symbols-outlined text-base">expand_more</span>
          </button>
          <div
            id="lang-dropdown"
            class="hidden absolute right-0 mt-2 bg-white shadow-lg rounded-lg border border-zinc-200 py-1 min-w-[100px] z-50"
          >
            <a
              href="/"
              class={`block px-4 py-2 text-sm transition-colors ${lang === 'pt-BR' ? 'bg-zinc-100 text-zinc-900 font-medium' : 'text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900'}`}
              data-lang="pt-BR"
            >
              Português
            </a>
            <a
              href="/en"
              class={`block px-4 py-2 text-sm transition-colors ${lang === 'en' ? 'bg-zinc-100 text-zinc-900 font-medium' : 'text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900'}`}
              data-lang="en"
            >
              English
            </a>
            <a
              href="/es"
              class={`block px-4 py-2 text-sm transition-colors ${lang === 'es' ? 'bg-zinc-100 text-zinc-900 font-medium' : 'text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900'}`}
              data-lang="es"
            >
              Español
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;

    // Scroll shadow effect
    window.addEventListener(
      "scroll",
      () => {
        const currentScroll = window.scrollY;

        if (currentScroll > 50) {
          navbar.classList.add("shadow-sm");
        } else {
          navbar.classList.remove("shadow-sm");
        }
      },
      { passive: true }
    );

    // Language selector dropdown
    const langSelector = document.getElementById("lang-selector");
    const langDropdown = document.getElementById("lang-dropdown");

    if (!langSelector || !langDropdown) return;

    // Toggle dropdown
    langSelector.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = langSelector.getAttribute("aria-expanded") === "true";

      if (isExpanded) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Close on outside click
    document.addEventListener("click", () => {
      closeDropdown();
    });

    // Prevent dropdown clicks from closing
    langDropdown.addEventListener("click", (e) => {
      e.stopPropagation();
    });

    // Store language preference when clicking a language link
    const langLinks = langDropdown.querySelectorAll("a[data-lang]");
    langLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const targetLang = link.getAttribute("data-lang");
        if (targetLang) {
          localStorage.setItem("preferredLanguage", targetLang);
        }
      });
    });

    function openDropdown() {
      langSelector?.setAttribute("aria-expanded", "true");
      langDropdown?.classList.remove("hidden");
    }

    function closeDropdown() {
      langSelector?.setAttribute("aria-expanded", "false");
      langDropdown?.classList.add("hidden");
    }
  });
</script>
