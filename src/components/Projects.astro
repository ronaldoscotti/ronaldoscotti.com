---
import type { Language } from '../i18n/types';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="projetos" class="py-10 sm:py-16 px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40">
  <div class="max-w-[960px] mx-auto">
    <div class="flex flex-col gap-4 text-center mb-10">
      <h2 class="text-zinc-900 text-[32px] md:text-4xl font-bold leading-tight tracking-[-0.033em] max-w-[720px] mx-auto">
        {t.projects.heading}
        <br />
        <small class="text-zinc-600 font-normal">{t.projects.subtitle}</small>
      </h2>
      <p class="text-zinc-600 text-lg font-normal leading-normal max-w-[720px] mx-auto">
        {t.projects.intro}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {t.projects.items.map((project) => (
        <a
          class="flex flex-row gap-4 items-center rounded-xl border border-zinc-200 bg-white p-4 transition-all duration-300 group hover:shadow-lg hover:shadow-zinc-200/50 hover:border-zinc-300 hover:-translate-y-1"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <!-- Image Column -->
          <div class="w-32 h-32 flex-shrink-0 overflow-hidden flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
            <img
              alt={`Mockup do ${project.name}`}
              class="w-full h-full object-cover"
              src={project.image}
            />
          </div>

          <!-- Text Column -->
          <div class="flex flex-col gap-1 flex-1 justify-center">
            <h3 class="text-zinc-900 text-lg font-bold leading-tight transition-colors duration-300 group-hover:text-zinc-700">
              {project.name}
            </h3>
            <p class="text-zinc-600 text-base font-normal leading-normal transition-colors duration-300 group-hover:text-zinc-700">
              {project.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
