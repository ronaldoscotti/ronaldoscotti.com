---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);

const [lead, ...rest] = t.projects.items;
---

<Section id={id} index={index} heading={t.projects.heading} intro={t.projects.intro}>
  <article class="lead reveal">
    <div class="lead-text">
      <h3>{lead.name}</h3>
      <p class="desc">{lead.description}</p>
      <p class="links">
        {lead.links.map((link) => <a href={link.url} rel="noopener">{link.label}</a>)}
      </p>
    </div>

    {
      lead.image && (
        <figure class="shot">
          <img src={lead.image} alt={lead.name} width="640" height="420" loading="lazy" decoding="async" />
        </figure>
      )
    }
  </article>

  <div class="rest">
    {
      rest.map((project) => (
        <article class="item reveal">
          {project.image && (
            <img
              class="thumb"
              src={project.image}
              alt=""
              width="320"
              height="200"
              loading="lazy"
              decoding="async"
            />
          )}
          <div>
            <h3>{project.name}</h3>
            <p class="desc">{project.description}</p>
            <p class="links">
              {project.links.map((link) => (
                <a href={link.url} rel="noopener">
                  {link.label}
                </a>
              ))}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .lead {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding-bottom: 2.25rem;
  }

  @media (min-width: 860px) {
    .lead {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }

  .shot {
    margin: 0;
  }

  .shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  h3 {
    margin-bottom: 0.625rem;
  }

  .desc {
    max-width: var(--measure);
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.875rem;
    font-size: 0.875rem;
  }

  .item {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 700px) {
    .item {
      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }

  .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 320 / 200;
    object-fit: cover;
    object-position: top center;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    filter: saturate(0.85);
  }

  @media (max-width: 699px) {
    .thumb {
      max-width: 10rem;
    }
  }
</style>
