---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);

const [lead, ...rest] = t.projects.items;
---

<Section id={id} index={index} heading={t.projects.heading} intro={t.projects.intro}>
  <article class="feature reveal">
    {
      lead.image && (
        <figure class="shot">
          <img
            class="fade-img"
            src={lead.image}
            alt={t.projects.screenshotAlt.replace("{name}", lead.name)}
            width="1280"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    <div class="feature-text">
      <p class="label">{t.projects.featuredLabel}</p>
      <h3>{lead.name}</h3>
      <p class="desc">{lead.description}</p>
      <p class="links">
        {
          lead.links.map((link) => (
            <a href={link.url} rel="noopener">
              {link.label}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </p>
    </div>
  </article>

  <div class="rest">
    {
      rest.map((project, i) => (
        <article class="card reveal" style={`--reveal-delay:${i * 90}ms`}>
          {project.image && (
            <div class="well">
              <img
                class="thumb fade-img"
                src={project.image}
                alt={t.projects.screenshotAlt.replace("{name}", project.name)}
                width="1280"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="card-text">
            <h3>{project.name}</h3>
            <p class="desc">{project.description}</p>
            <p class="links">
              {project.links.map((link) => (
                <a href={link.url} rel="noopener">
                  {link.label}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              ))}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  /* One project gets the room a case study needs; the others stay a compact
     row of cards so the section doesn't read as four equal claims. */
  .feature {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    padding: 1.25rem;
    margin-bottom: 2.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 14px;
  }

  @media (min-width: 860px) {
    .feature {
      grid-template-columns: 1.15fr minmax(0, 1fr);
      gap: 2.25rem;
      padding: 1.5rem;
    }
  }

  .shot {
    margin: 0;
    overflow: hidden;
    border-radius: 10px;
    background: var(--color-well);
  }

  .shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .feature:hover .shot img {
    transform: scale(1.03);
  }

  .feature-text .label {
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .feature h3 {
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    margin-bottom: 0.75rem;
  }

  .rest {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 220ms ease, transform 220ms ease;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-rule));
    transform: translateY(-3px);
  }

  .well {
    background: var(--color-well);
    overflow: hidden;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .card:hover .thumb {
    transform: scale(1.04);
  }

  .card-text {
    padding: 1.125rem 1.25rem 1.375rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .desc {
    color: var(--color-ink-mute);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .feature .desc {
    font-size: 0.96875rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }

  .card .desc {
    flex: 1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.9375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .links a {
    color: var(--color-accent-deep);
    text-decoration: none;
  }

  .arrow {
    display: inline-block;
    margin-inline-start: 0.25rem;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .links a:hover .arrow {
    transform: translateX(3px);
  }
</style>
