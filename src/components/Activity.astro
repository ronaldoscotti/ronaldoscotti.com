---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";
import Heatmap from "./Heatmap.astro";
import activity from "../data/activity.json";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);
const locale = lang === "en" ? "en-US" : "pt-BR";

const gh = (activity as any).github;
/** Source-agnostic: any provider that yields { name, percent }. */
const languages = ((activity as any).languages?.items ?? []).map((l: any) => ({
  ...l,
  name: l.name === "__other__" ? t.activity.otherLanguages : l.name,
}));

const fmt = (n: number) => n.toLocaleString(locale);

const summary = gh
  ? t.activity.contributions.replace("{total}", fmt(gh.total)).replace("{days}", String(gh.activeDays))
  : "";

/** Kept as parts so the two figures can be counted up individually. */
const summaryParts = gh
  ? `${t.activity.contributions}.`
      .split(/(\{total\}|\{days\})/)
      .map((part) =>
        part === "{total}"
          ? { count: gh.total, text: fmt(gh.total) }
          : part === "{days}"
            ? { count: gh.activeDays, text: String(gh.activeDays) }
            : { count: null, text: part },
      )
  : [];

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString(locale, {
    month: "short",
    year: "numeric",
  });
---

<Section id={id} index={index} heading={t.activity.heading}>
  {
    gh && (
      <div class="block reveal">
        <p class="summary">{summaryParts.map((part) => (part.count === null ? part.text : <span class="tick" data-count-to={part.count}>{part.text}</span>))} <a class="gh" href="https://github.com/ronaldoscotti" rel="noopener">{t.activity.githubCta}<span class="arrow" aria-hidden="true">→</span></a></p>
        <Heatmap weeks={gh.weeks} label={`${summary}.`} />
        <p class="mono range">
          {fmtDate(gh.from)} — {fmtDate(gh.to)}
        </p>
      </div>
    )
  }

  {
    languages.length > 0 && (
      <div class="block reveal">
        <h3 class="label sub">{t.activity.languagesHeading}</h3>
        <div
          class="bar"
          role="img"
          aria-label={languages.map((l: any) => `${l.name} ${l.percent}%`).join(", ")}
        >
          {languages.map((l: any, i: number) => (
            <span
              class="slice"
              style={`width:${l.percent}%;--tone:${0.5 + (i / Math.max(languages.length - 1, 1)) * 0.5};--i:${i}`}
            />
          ))}
        </div>
        <ul class="legend">
          {languages.map((l: any, i: number) => (
            <li>
              <span
                class="swatch"
                style={`--tone:${0.5 + (i / Math.max(languages.length - 1, 1)) * 0.5}`}
              />
              <span class="mono">
                {l.name} {l.percent}%
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="block reveal">
    <h3 class="label sub">{t.activity.stackHeading}</h3>
    <div class="stack">
      {t.activity.stack.map((line) => <p>{line}</p>)}
    </div>
  </div>
</Section>

<style>
  .block + .block {
    margin-top: 2.75rem;
  }

  .summary {
    max-width: 44rem;
    margin-bottom: 1.5rem;
    color: var(--color-ink-mute);
  }

  .tick {
    display: inline-block;
    color: var(--color-ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .gh {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent-deep);
    text-decoration: none;
    white-space: nowrap;
  }

  .gh .arrow {
    display: inline-block;
    margin-inline-start: 0.25rem;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .gh:hover .arrow {
    transform: translateX(3px);
  }

  .range {
    margin-top: 0.75rem;
    font-size: 0.6875rem;
  }

  .sub {
    margin-bottom: 0.875rem;
  }

  .bar {
    display: flex;
    height: 9px;
    max-width: 44rem;
    border-radius: 5px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-rule) 60%, transparent);
  }

  .slice {
    background: color-mix(
      in srgb,
      var(--color-accent) calc(var(--tone) * 100%),
      var(--color-paper-deep)
    );
    transform: scaleX(0);
    transform-origin: left;
  }

  /* The bar draws itself left to right once the block lands in view. */
  .is-in .slice {
    animation: barGrow 700ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 70ms);
  }

  @keyframes barGrow {
    to {
      transform: scaleX(1);
    }
  }

  .slice + .slice {
    box-shadow: inset 1px 0 0 var(--color-paper);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.125rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
  }

  .legend .mono {
    font-size: 0.75rem;
  }

  .swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: color-mix(
      in srgb,
      var(--color-accent) calc(var(--tone) * 100%),
      var(--color-paper-deep)
    );
  }

  .stack {
    max-width: 48rem;
    color: var(--color-ink-soft);
  }

  .stack p {
    font-size: 0.9375rem;
    line-height: 1.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .slice {
      transform: none;
    }
  }
</style>

<script>
  const ticks = document.querySelectorAll<HTMLElement>(".tick[data-count-to]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (ticks.length && !reduce && "IntersectionObserver" in window) {
    // Digits roll up once, when the figure first scrolls into view.
    const run = (el: HTMLElement) => {
      // Pin the rendered width first: a figure counting up from 0 gains digits
      // and a thousands separator, which would reflow the sentence around it.
      el.style.minWidth = `${el.getBoundingClientRect().width}px`;

      const target = Number(el.dataset.countTo);
      const format = new Intl.NumberFormat(document.documentElement.lang);
      const start = performance.now();
      const DURATION = 1100;

      const step = (now: number) => {
        const p = Math.min((now - start) / DURATION, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = format.format(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          run(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );

    ticks.forEach((el) => io.observe(el));
  }
</script>
