---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";
import { yearsOfExperience } from "../data/site";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);

const intro = t.experience.intro.replace("{years}", String(yearsOfExperience));
---

<Section id={id} index={index} heading={t.experience.heading} intro={intro}>
  <a slot="head-extra" href="/cv.pdf" class="btn resume no-print" download>
    {t.experience.resumeCta}
  </a>

  <div class="jobs">
    {
      t.experience.jobs.map((job, i) => (
        <article class="job reveal" style={`--reveal-delay:${i * 70}ms`}>
          <p class="mono period">{job.period}</p>

          <div class="body">
            <h3>
              {job.role}
              <span class="org">· {job.org}</span>
            </h3>
            <p class="summary">{job.summary}</p>
            {job.bullets.length > 0 && (
              <ul>
                {job.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }

    <article class="job reveal">
      <p class="mono period">{t.experience.educationHeading}</p>
      <div class="body">
        <ul class="plain">
          {t.experience.education.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </article>
  </div>
</Section>

<style>
  .resume {
    margin-top: 1.375rem;
  }

  .job {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 780px) {
    .job {
      grid-template-columns: 13.5rem minmax(0, 1fr);
      gap: 1.875rem;
    }
  }

  .period {
    font-size: 0.75rem;
    line-height: 1.7;
    padding-top: 0.5rem;
  }

  h3 {
    margin-bottom: 0.75rem;
  }

  .org {
    color: var(--color-accent);
    font-weight: 600;
    font-style: italic;
  }

  .summary {
    max-width: 41rem;
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 41rem;
    display: flex;
    flex-direction: column;
    gap: 0.8125rem;
  }

  li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-mute);
  }

  /* An em dash in gold, not a bullet: the list should read as a printed
     column, not a UI. */
  li::before {
    content: "—";
    color: var(--color-accent);
  }

  .plain {
    gap: 0.5625rem;
  }

  .plain li {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }

  .plain li::before {
    content: none;
  }
</style>
