---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";
import { yearsOfExperience } from "../data/site";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);

const intro = t.experience.intro.replace("{years}", String(yearsOfExperience));
---

<Section id={id} index={index} heading={t.experience.heading} intro={intro}>
  <a slot="head-extra" href="/cv.pdf" class="btn resume no-print" download>
    {t.experience.resumeCta}
  </a>

  <div class="jobs">
    {
      t.experience.jobs.map((job) => (
        <article class="job reveal">
          <p class="mono period">{job.period}</p>

          <div class="body">
            <h3>
              {job.role}
              <span class="org">· {job.org}</span>
            </h3>
            <p class="summary">{job.summary}</p>
            {job.bullets.length > 0 && (
              <ul>
                {job.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }

    <article class="job reveal">
      <p class="mono period">{t.experience.educationHeading}</p>
      <div class="body">
        <ul class="plain">
          {t.experience.education.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </article>
  </div>
</Section>

<style>
  .resume {
    margin-top: 1.25rem;
  }

  .job {
    display: grid;
    gap: 0.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-rule);
  }

  .job:first-child {
    border-top: none;
    padding-top: 0;
  }

  @media (min-width: 780px) {
    .job {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .period {
    padding-top: 0.3125rem;
  }

  h3 {
    margin-bottom: 0.625rem;
  }

  .org {
    color: var(--color-ink-mute);
    font-weight: 400;
  }

  .summary {
    max-width: var(--measure);
    color: var(--color-ink-soft);
    margin-bottom: 1.125rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 44rem;
  }

  li {
    position: relative;
    padding-left: 1.125rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  li + li {
    margin-top: 0.75rem;
  }

  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6875em;
    width: 5px;
    height: 1px;
    background: var(--color-accent);
  }

  .plain li::before {
    display: none;
  }

  .plain li {
    padding-left: 0;
  }
</style>
