---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Sky from "./Sky.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

/** Split so the two lines of the name rise in one after the other. */
const nameLines = t.hero.name.split(" ");
---

<section class="hero">
  <div class="wrap inner">
    <div class="text">
      <p class="eyebrow role">{t.hero.role}</p>
      <h1>
        {nameLines.map((line, i) => <span class="line" style={`--i:${i}`}>{line}</span>)}
      </h1>
      <p class="tagline">{t.hero.tagline}</p>
      <p class="intro">{t.hero.intro}</p>
    </div>

    <div class="portrait">
      <Sky caption={t.hero.skyCaption} />
      <span class="sr-only">{t.hero.photoAlt}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-paper-deep);
    overflow: hidden;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 0;
  }

  .text {
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  .role {
    letter-spacing: 0.2em;
    color: var(--color-accent);
    margin-bottom: 1.375rem;
    animation: riseIn 700ms 50ms both;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .line {
    display: block;
    animation: riseIn 800ms both;
    animation-delay: calc(120ms + var(--i) * 100ms);
  }

  .tagline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
    line-height: 1.28;
    color: var(--color-ink-soft);
    max-width: 28ch;
    margin-bottom: 1.375rem;
    animation: riseIn 800ms 320ms both;
  }

  .intro {
    max-width: var(--measure);
    font-size: 1rem;
    line-height: 1.62;
    color: var(--color-ink-mute);
    animation: riseIn 800ms 420ms both;
  }

  /* width is load-bearing: `justify-self: center` below makes this grid item
     shrink to its content, which collapsed the whole sky to nothing on the page
     that has no caption under it. */
  .portrait {
    position: relative;
    width: 100%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 860px) {
    .inner {
      grid-template-columns: 1.35fr minmax(0, 1fr);
      gap: 3rem;
    }

    .text {
      padding-block: clamp(3.5rem, 9vh, 5.5rem);
    }

    .portrait {
      max-width: 20rem;
      justify-self: center;
    }
  }

  @media (max-width: 859px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) 11rem;
      align-items: end;
      column-gap: 1.25rem;
      padding-bottom: 2rem;
    }

    .text {
      grid-column: 1 / -1;
      padding-bottom: 1.5rem;
    }

    .portrait {
      grid-column: 2;
    }
  }

  /* Below this the two-column split leaves an L-shaped void beside the
     portrait, so it becomes a single centred column instead. */
  @media (max-width: 560px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      grid-column: 1;
      width: 13rem;
      justify-self: center;
    }
  }
</style>
