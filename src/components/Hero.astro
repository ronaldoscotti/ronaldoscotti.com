---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="hero">
  <div class="wrap inner">
    <div class="text">
      <p class="eyebrow">{t.hero.role}</p>
      <h1>{t.hero.name}</h1>
      <p class="tagline">{t.hero.tagline}</p>
      <p class="intro">{t.hero.intro}</p>
    </div>

    <figure class="portrait">
      <img
        src="/ronaldo-scotti.webp"
        alt={t.hero.photoAlt}
        width="1000"
        height="1000"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-paper-deep);
    border-bottom: 1px solid var(--color-rule);
    overflow: hidden;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: 0;
  }

  .text {
    padding-block: clamp(3rem, 8vh, 5.5rem);
  }

  .eyebrow {
    margin-bottom: 1rem;
  }

  h1 {
    margin-bottom: 1.125rem;
  }

  .tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    line-height: 1.35;
    color: var(--color-ink-soft);
    max-width: 32ch;
    margin-bottom: 1.125rem;
  }

  .intro {
    max-width: var(--measure);
    color: var(--color-ink-soft);
  }

  .portrait {
    margin: 0;
    align-self: end;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    filter: saturate(0.94) contrast(1.03);
  }

  @media (min-width: 860px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: 2rem;
    }

    .text {
      padding-block: clamp(3rem, 7vh, 4.5rem);
    }

    /* Bleeds past the container so the portrait reads large without stealing
       width from the name. */
    .portrait img {
      width: calc(100% + 4.5rem);
      max-width: none;
      margin-inline-end: -4.5rem;
    }

    /* Stands on the section rule instead of floating in a box, so it never
       reads as a photo cropped at the chest. */
    .portrait {
      margin-bottom: -1px;
    }
  }

  @media (max-width: 859px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) 12rem;
      align-items: end;
      column-gap: 1rem;
    }

    .text {
      grid-column: 1 / -1;
      padding-bottom: 1.5rem;
    }

    .portrait {
      grid-column: 2;
      margin-bottom: -1px;
      margin-inline-end: -1.5rem;
    }
  }

  @media (max-width: 560px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) 10rem;
    }
  }
</style>
