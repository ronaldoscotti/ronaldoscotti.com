---
import type { Language } from '../i18n/types';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="sobre" class="py-10 sm:py-16 px-4 sm:px-8 md:px-16 lg:px-24 xl:px-40">
  <div class="max-w-[960px] mx-auto">
    <div class="flex flex-col gap-6 md:flex-row-reverse md:items-center md:gap-8">
      <!-- Photo -->
      <div class="w-full aspect-square bg-center bg-no-repeat bg-cover rounded-full md:w-60 md:min-w-[240px] mx-auto md:mx-0 max-w-[240px]"
           style="background-image: url('/ronaldo-scotti.jpeg');"></div>

      <!-- Text Content -->
      <div class="flex flex-col gap-6 text-center md:text-left md:justify-center md:flex-1">
        <div class="flex flex-col gap-2">
          <h1 class="text-zinc-900 text-4xl md:text-5xl font-black leading-tight tracking-[-0.033em]">
            {t.hero.heading}
          </h1>
          <h2 class="text-zinc-600 text-base md:text-lg font-normal leading-normal">
            {t.hero.subheading}
          </h2>
        </div>
      </div>
    </div>
  </div>
</section>
