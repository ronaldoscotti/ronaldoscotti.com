---
import type { Language } from "../i18n/types";
import { getTranslations } from "../i18n/utils";
import Section from "./Section.astro";
import data from "../data/posts.json";

interface Props {
  lang: Language;
  index: string;
  id: string;
}

const { lang, index, id } = Astro.props;
const t = getTranslations(lang);

const key = lang === "en" ? "en" : "pt";
const locale = lang === "en" ? "en-US" : "pt-BR";
const VISIBLE = 4;

const posts = data.posts.map((post, i) => ({
  ...post,
  ...(post as any)[key],
  hidden: i >= VISIBLE,
  displayDate: new Date(`${post.date}T00:00:00`).toLocaleDateString(locale, {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }),
}));

const hiddenCount = posts.length - VISIBLE;
const foreign = lang === "en";
---

<Section id={id} index={index} heading={t.writing.heading} intro={t.writing.intro}>
  <ol class="list" id="post-list">
    {
      posts.map((post) => (
        <li class:list={["post", { "is-hidden": post.hidden }]} hidden={post.hidden}>
          <a
            class="link"
            href={post.url}
            target="_blank"
            rel="noopener"
            hreflang="pt-BR"
            lang={foreign ? undefined : "pt-BR"}
          >
            <img
              class="cover"
              src={post.image}
              alt=""
              width="300"
              height="214"
              loading="lazy"
              decoding="async"
            />

            <span class="text">
              <span class="meta">
                <time class="mono" datetime={post.date}>
                  {post.displayDate}
                </time>
                <span class="badge">{t.writing.badge}</span>
                {foreign && (
                  <span class="badge lang" title={t.writing.languageNote}>
                    {t.writing.languageTag}
                  </span>
                )}
              </span>
              <span class="title">{post.title}</span>
              <span class="sub">{post.subtitle}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="actions">
    {
      hiddenCount > 0 && (
        <button type="button" class="btn no-print" id="more" aria-controls="post-list">
          {t.writing.more}
          <span class="mono count">+{hiddenCount}</span>
        </button>
      )
    }
    <a class="archive" href={data.source.archiveUrl} target="_blank" rel="noopener" hreflang="pt-BR">
      {t.writing.archive}
    </a>
  </div>
</Section>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post {
    border-top: 1px solid var(--color-rule);
  }

  .post:first-child {
    border-top: none;
  }

  .link {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    padding-block: 1.5rem;
    text-decoration: none;
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 300 / 214;
    object-fit: cover;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    filter: saturate(0.85);
    transition: filter 200ms ease;
  }

  .link:hover .cover {
    filter: saturate(1);
  }

  .text {
    display: block;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.375rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    padding: 0.0625rem 0.375rem;
  }

  .badge.lang {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    color: var(--color-accent-deep);
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.3;
    color: var(--color-ink);
    margin-bottom: 0.3125rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 160ms ease;
  }

  .link:hover .title {
    text-decoration-color: var(--color-accent);
  }

  .sub {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }

  @media (max-width: 600px) {
    .link {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.25rem;
    }

    .title {
      font-size: 1.0625rem;
    }

    .sub {
      font-size: 0.875rem;
    }
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-rule);
  }

  .count {
    color: inherit;
    opacity: 0.6;
  }

  .archive {
    font-size: 0.875rem;
  }

  html:not(.js) .post.is-hidden {
    display: list-item;
  }

  html:not(.js) #more {
    display: none;
  }
</style>

<script>
  document.documentElement.classList.add("js");

  const button = document.getElementById("more");
  const list = document.getElementById("post-list");

  button?.addEventListener("click", () => {
    const hidden = list?.querySelectorAll<HTMLLIElement>(".post.is-hidden");
    if (!hidden?.length) return;

    hidden.forEach((item) => {
      item.hidden = false;
      item.classList.remove("is-hidden");
    });

    button.remove();

    const first = hidden[0]?.querySelector<HTMLAnchorElement>("a");
    first?.setAttribute("tabindex", "-1");
    first?.focus({ preventScroll: true });
  });
</script>
